// Schema de Bills — sistema de gestión para comercios chicos.
//
// El dominio es genérico a propósito: un mismo core (catálogo, ventas, caja,
// stock, proveedores, promociones, clientes) que cada negocio activa según su
// rubro (ver `vertical` y `BusinessModuleAccess`). Un kiosco y una barbería
// usan los mismos modelos; lo que cambia es qué módulos ve y cómo se llaman
// las cosas en pantalla (ver src/lib/vertical.ts).
//
// Convenciones:
//   - Los montos son enteros en PESOS (sin centavos). Ver src/lib/money.ts.
//   - Las cantidades son enteros en MILÉSIMAS de unidad, para poder vender
//     1,250 kg o 2,5 m. Ver src/lib/quantity.ts (QUANTITY_SCALE = 1000).
//   - Borrado lógico (`deleted`/`deletedAt`/`deletedById`) en todo lo que el
//     usuario administra; los libros contables (movimientos, asientos) son
//     append-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────────────────────
// Negocio, rubro y módulos
// ─────────────────────────────────────────────────────────────────────────────

model Business {
  id          String    @id @default(cuid())
  name        String
  vertical    Vertical  @default(GENERAL)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  // Datos fiscales del emisor, prerequisito de facturación electrónica AFIP/ARCA.
  // Nullable: hasta que el dueño los carga no hay un valor por defecto razonable.
  cuit             String?
  taxCondition     TaxCondition?
  salesPointNumber Int?

  // Certificado de producción AFIP, cifrado en reposo (ver src/lib/crypto.ts):
  // nunca se guarda en texto plano.
  afipCertEncrypted String?
  afipKeyEncrypted  String?
  afipCertAlias     String?
  afipCertCreatedAt DateTime?

  // ── Marketing ──────────────────────────────────────────────────────────────
  // Token del link público del negocio (/n/<token>). Igual que en presupuestos:
  // el token ES la credencial, por eso es random y no el id.
  publicToken     String?  @unique
  publicPageActive Boolean @default(false)
  // Texto libre que se muestra en la página pública (horarios, dirección…).
  publicNote      String?
  // Link para pedir reseña (Google Maps). Se manda por WhatsApp después de cobrar.
  googleReviewUrl String?
  // Puntos: cada cuántos pesos se suma 1 punto y cuánto vale 1 punto al canjear.
  // null = el programa está apagado aunque el módulo esté prendido.
  pointsPerAmount Int?
  pointValue      Int?

  branches               Branch[]
  users                  User[]
  products               Product[]
  categories             ProductCategory[]
  expenses               Expense[]
  accountOpeningBalances AccountOpeningBalance[]
  accountTransfers       AccountTransfer[]
  cashCloses             CashClose[]
  modules                BusinessModuleAccess[]
  suppliers              Supplier[]
  purchases              Purchase[]
  promotions             Promotion[]
  customers              Customer[]
  appointments           Appointment[]
  productFamilies        ProductFamily[]
  quotes                 Quote[]
  loyaltyEntries         LoyaltyEntry[]

  @@index([deletedAt])
  modifierGroups ModifierGroup[]
  modifiers      Modifier[]
  sectors   Sector[]
  tables    Table[]
  orders    Order[]
  productions Production[]
  wastes      Waste[]
}

// Rubro del negocio. Solo define los DEFAULTS del onboarding (qué módulos se
// prenden y cómo se nombran las cosas); después cada negocio ajusta lo que
// quiera. Nunca condiciona la lógica de negocio: el core es el mismo para todos.
enum Vertical {
  BARBERSHOP // Barbería / peluquería
  BEAUTY // Estética, uñas, spa
  CLOTHING // Local de ropa / indumentaria
  KIOSK // Kiosco / drugstore
  GROCERY // Verdulería / fiambrería / dietética
  HABERDASHERY // Mercería / bazar
  HARDWARE // Ferretería / corralón
  BAKERY // Panadería / pastelería / confitería
  GENERAL // Cualquier otro comercio
}

// Módulos activables. SALES y REPORTS están siempre activos (no se persisten
// como fila); el resto se prende por negocio según el rubro.
enum AppModule {
  CASH // Caja: saldos por cuenta, transferencias y cierre
  EXPENSES // Gastos
  STOCK // Inventario y movimientos
  SUPPLIERS // Proveedores y cuentas a pagar
  PROMOTIONS // Promociones y descuentos
  CUSTOMERS // Clientes y cuenta corriente (fiado)
  INVOICING // Facturación electrónica AFIP/ARCA
  TERMINALS // Terminales por empleado (venta autogestionada con PIN)
  STAFF_COMMISSIONS // Comisiones por empleado sobre lo vendido
  APPOINTMENTS // Agenda de turnos (barbería, estética)
  QUOTES // Presupuestos: cotizar antes de vender (ferretería, mercería, corralón)
  MARKETING // Recuperar clientes, cumpleaños, puntos y la página pública del negocio
  TABLES // Salón: sectores, mesas y comandas (gastronomía)
  KITCHEN // Pantalla de cocina: qué preparar y en qué orden (gastronomía)
  RECIPES // Recetas, producción y mermas: qué ingrediente consume cada producto
}

// Un módulo prendido para un negocio. La ausencia de fila = módulo apagado.
model BusinessModuleAccess {
  id         String    @id @default(cuid())
  businessId String
  module     AppModule
  enabledAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, module])
  @@index([businessId])
}

model Branch {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  address     String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users                  User[]
  productPrices          BranchProductPrice[]
  sales                  Sale[]
  terminals              Terminal[]
  expenses               Expense[]
  accountOpeningBalances AccountOpeningBalance[]
  accountTransfers       AccountTransfer[]
  cashCloses             CashClose[]
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  purchases              Purchase[]
  promotionBranches      PromotionBranch[]
  customerAccountEntries CustomerAccountEntry[]
  saleReturns            SaleReturn[]
  appointments           Appointment[]
  quotes                 Quote[]

  @@index([businessId])
  @@index([deletedAt])
  sectors Sector[]
  tables  Table[]
  orders  Order[]
  productions Production[]
  wastes      Waste[]
}

model Terminal {
  id          String    @id @default(cuid())
  branchId    String
  staffId     String?
  name        String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff  User?  @relation("StaffTerminals", fields: [staffId], references: [id], onDelete: SetNull)
  sales  Sale[]

  @@index([branchId])
  @@index([staffId])
  @@index([deletedAt])
}

model User {
  id           String    @id @default(cuid())
  businessId   String
  branchId     String?
  name         String
  email        String?
  username     String?   @unique
  passwordHash String?
  pinHash      String?
  role         UserRole
  active       Boolean   @default(true)
  // Empleado "encargado": puede cerrar la caja de su sucursal desde la terminal (con su PIN).
  canCloseCash Boolean   @default(false)
  // Comisión sobre lo que vende, en puntos porcentuales (0-100). Solo se usa
  // con el módulo STAFF_COMMISSIONS prendido.
  commissionRate Int     @default(0)
  // Con qué fila vende este usuario.
  //
  // En un comercio chico el dueño atiende, y termina siendo DOS usuarios: el que
  // loguea (OWNER, sin sucursal, con contraseña) y el que vende (STAFF, atado a
  // una sucursal, con PIN). Tienen que ser dos porque `Sale.staffId` exige rol
  // STAFF y sucursal —de ahí salen las comisiones y el cierre—, y el dueño no
  // tiene ninguna de las dos cosas.
  //
  // Esto las une, para que al entrar a vender la app sepa que ese empleado es él
  // y no se lo pregunte. null = este usuario no vende (o todavía no se vinculó).
  sellsAsId    String?
  createdAt    DateTime  @default(now())
  createdById  String?
  updatedAt    DateTime  @updatedAt
  updatedById  String?
  deleted      Boolean   @default(false)
  deletedAt    DateTime?
  deletedById  String?

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // SetNull y no Cascade: si se borra al empleado, el dueño se queda sin
  // identidad de venta, no sin cuenta.
  sellsAs   User?      @relation("UserSellsAs", fields: [sellsAsId], references: [id], onDelete: SetNull)
  sellsFor  User[]     @relation("UserSellsAs")
  sales        Sale[]        @relation("StaffSales")
  terminals    Terminal[]    @relation("StaffTerminals")
  appointments Appointment[] @relation("StaffAppointments")

  @@unique([businessId, email])
  @@index([businessId])
  @@index([branchId])
  @@index([deletedAt])
  orders Order[]
  productions Production[]
  wastes      Waste[]
}

// Roles por TAREA, no por jerarquía lineal. Un mozo y un cocinero comparten
// rango pero hacen cosas ajenas entre sí: no hay uno "más arriba" que el otro.
// Qué puede cada uno se define en src/lib/capabilities.ts, que es la única
// fuente de verdad para la nav y para los guards del servidor.
enum UserRole {
  OWNER // dueño
  ADMIN // socio o encargado general
  MANAGER // encargado de local: la operación completa, sin equipo ni fiscal
  CASHIER // caja: cobra y arquea, no anula
  WAITER // mozo: toma pedidos en el salón, no toca la plata
  COOK // cocina: solo la pantalla de preparación
  STAFF // empleado de mostrador (vende por terminal)
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogo: un solo modelo para servicios (barbería) y productos (comercio)
// ─────────────────────────────────────────────────────────────────────────────

// Familia de productos: "Remera lisa" que existe en varios talles y colores.
//
// Cada variante sigue siendo un Product con su propio código de barras, su
// precio y su stock — que es como funciona de verdad en un local de ropa: la
// etiqueta que se escanea es la del talle, no la del modelo. La familia existe
// para que el catálogo y el mostrador las muestren juntas en vez de como
// cinco productos sueltos.
model ProductFamily {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  deleted     Boolean   @default(false)
  deletedAt   DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([businessId])
  @@index([deletedAt])
}

model ProductCategory {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  color       String?
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products         Product[]
  promotionTargets PromotionTarget[]

  @@index([businessId])
  @@index([deletedAt])
}

// Un ítem vendible. `kind` distingue el servicio (no descuenta stock, no tiene
// costo de compra) del producto físico (stock, costo, código de barras).
// ─────────────────────────────────────────────────────────────────────────────
// Opciones de producto (modificadores)
//
// "Con leche descremada", "sin azúcar", "extra jamón". Nacen con la
// gastronomía pero no son exclusivas de ella: una ferretería que corta a
// medida o una mercería que vende por color usan lo mismo.
//
// La validación vive en src/modules/catalog/modifiers.ts, y ahí está la regla
// que importa: un modificador solo se puede elegir si su grupo está asignado a
// ESE producto. Sin eso, quien arma el pedido desde la carta pública puede
// colgarle a su café una opción de ajuste negativo de otro producto.
// ─────────────────────────────────────────────────────────────────────────────

model ModifierGroup {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  // Hay que elegir al menos uno para poder agregar el producto.
  required    Boolean   @default(false)
  minSelect   Int       @default(0)
  // 1 = elegir una; >1 = varias.
  maxSelect   Int       @default(1)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  modifiers Modifier[]
  // A qué productos se les ofrece este grupo. Es la relación que hace posible
  // la validación de pertenencia.
  products  Product[]

  @@index([businessId])
}

model Modifier {
  id          String    @id @default(cuid())
  businessId  String
  groupId     String
  name        String
  // Cuánto suma o resta al precio del producto, en pesos enteros. Puede ser
  // negativo ("sin queso −$300"), y por eso el precio efectivo tiene piso en
  // cero (ver effectiveUnitPrice).
  priceDelta  Int       @default(0)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group    ModifierGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  saleItem SaleItemModifier[]

  @@index([businessId])
  @@index([groupId])
  orderItem OrderItemModifier[]
}

// Qué opciones llevaba un renglón vendido.
//
// Guarda copia del nombre y del ajuste, igual que SaleItem copia el nombre del
// producto en `description`: si mañana se edita o se borra el modificador, el
// comprobante viejo tiene que seguir diciendo qué se vendió y a cuánto.
model SaleItemModifier {
  id         String @id @default(cuid())
  saleItemId String
  modifierId String?
  name       String
  priceDelta Int    @default(0)

  saleItem SaleItem  @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  modifier Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  @@index([saleItemId])
}

model Product {
  id          String      @id @default(cuid())
  businessId  String
  categoryId  String?
  // Familia a la que pertenece (talle/color de un mismo modelo). null = producto suelto.
  familyId    String?
  // Cómo se llama esta variante dentro de la familia: "Talle M", "Negro · L".
  variantLabel String?
  name        String
  description String?
  kind        ProductKind @default(SERVICE)
  unit        Unit        @default(UNIT)
  sku         String?
  barcode     String?
  // Costo de reposición (pesos por unidad de medida). Alimenta el margen en reportes.
  cost        Int?
  // Cuándo se cargó la foto. Vive acá (y no en ProductImage) para que un
  // listado sepa si hay foto y pueda cachearla sin traerse los bytes.
  imageUpdatedAt DateTime?
  // Qué producto del catálogo de rubro es ("banana", "tomate-perita"). Sirve
  // para mostrar la foto genérica sin que el negocio suba nada: una verdulería
  // no tiene por qué fotografiar una banana, y las 300 leen el mismo archivo.
  // La foto propia, si la hay, siempre le gana. null = producto cargado a mano.
  catalogSlug String?
  // Si es true, vender descuenta de StockLevel y se avisa cuando falta.
  trackStock  Boolean     @default(false)
  // Punto de reposición: por debajo de esto la app avisa. En milésimas.
  minStock    Int?
  // Venta por bulto: cuántas unidades trae la caja/pack. El stock se sigue
  // llevando en unidades sueltas (una caja abierta se vende de a uno), así que
  // esto es solo un atajo de carga: "+1 caja" agrega packSize unidades.
  packSize    Int?
  // Cuántos minutos tarda la cocina en prepararlo. Alimenta el semáforo de
  // demora del KDS: sin esto el reloj corre pero no hay contra qué compararlo.
  // Nullable porque la mayoría no lo carga (en Migas, 6 de 56).
  prepMinutes Int?
  // Cómo lo llama el rubro: "caja", "bulto", "docena", "plancha".
  packLabel   String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  createdById String?
  updatedAt   DateTime    @updatedAt
  updatedById String?
  deleted     Boolean     @default(false)
  deletedAt   DateTime?
  deletedById String?

  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category         ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  family           ProductFamily?       @relation(fields: [familyId], references: [id], onDelete: SetNull)
  image            ProductImage?
  branchPrices     BranchProductPrice[]
  saleItems        SaleItem[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseItem[]
  promotionTargets PromotionTarget[]
  appointments     Appointment[]
  quoteItems       QuoteItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([familyId])
  @@index([categoryId])
  @@index([barcode])
  @@index([deletedAt])
  // Qué opciones se le ofrecen (ver src/modules/catalog/modifiers.ts).
  modifierGroups ModifierGroup[]
  orderItems OrderItem[]
  receta      RecipeItem[] @relation("RecetaDelProducto")
  usadoEnRecetas RecipeItem[] @relation("InsumoEnRecetas")
  productions Production[]
  wastes      Waste[]
}

enum ProductKind {
  SERVICE // Trabajo/servicio: sin stock ni costo de compra
  GOOD // Producto físico: stock, costo, código de barras
  // Insumo: se compra, tiene stock y costo, pero NUNCA se vende. La harina de
  // una panadería. Es un Product y no un modelo aparte porque un ingrediente ES
  // un producto que no vendés: separarlo obligaba a duplicar stock,
  // movimientos, compras y proveedores para expresar esa única diferencia.
  // Todo listado de venta tiene que filtrarlo (ver `seVende` en
  // src/modules/tables/recipes.ts).
  INGREDIENT
}

// Foto del producto, en tabla aparte para que ningún listado arrastre los bytes
// sin querer. Se guarda ya normalizada (ver src/modules/catalog/product-image):
// una miniatura chica alcanza para elegir de un vistazo en el mostrador.
model ProductImage {
  productId   String   @id
  data        Bytes
  contentType String
  width       Int
  height      Int
  // Tamaño en bytes, para poder mostrar cuánto ocupa el catálogo.
  byteSize    Int
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Unidad de medida de venta. Las que no son UNIT admiten cantidades
// fraccionarias (ver src/lib/quantity.ts).
enum Unit {
  UNIT // unidad
  KG // kilogramo
  GRAM // gramo
  LITER // litro
  METER // metro
  PACK // paquete/pack
  DOZEN // docena
}

// El precio de venta vive por sucursal: el mismo producto puede valer distinto
// en Centro que en Palermo.
model BranchProductPrice {
  id          String    @id @default(cuid())
  branchId    String
  productId   String
  price       Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([productId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ventas
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Salón: sectores, mesas y comandas (módulos TABLES y KITCHEN)
//
// Una comanda se diferencia de una venta de mostrador en que existe un rato
// largo antes de cobrarse, y en ese rato la tocan el mozo, la cocina y el
// cajero, a veces desde dispositivos distintos y al mismo tiempo. De ahí el
// `version` para concurrencia y los estados por renglón.
//
// Las reglas de quién puede qué están en src/modules/tables/order-lifecycle.ts.
// ─────────────────────────────────────────────────────────────────────────────

// De dónde salió la venta. El mostrador es el default y es lo que hacen todos
// los rubros; el salón y el para-llevar los suma la gastronomía.
enum SaleChannel {
  COUNTER
  TABLE
  TAKEAWAY
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

// Estado de un renglón en la pantalla de cocina.
enum KdsStatus {
  // Lo cargó el cliente desde el QR y todavía no lo confirmó el mozo: no viajó
  // a cocina y no cuenta para el total.
  CART
  PENDING
  PREPARING
  READY
  DELIVERED
}

model Sector {
  id          String    @id @default(cuid())
  businessId  String
  branchId    String
  name        String
  // Los sectores nuevos van al FINAL, no en cero. Con todos empatados en 0 el
  // orden queda indefinido, y la mesa que se crea a continuación cae en un
  // sector arbitrario en vez de en el que el usuario está mirando.
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables   Table[]

  @@index([businessId])
  @@index([branchId])
}

model Table {
  id          String      @id @default(cuid())
  businessId  String
  branchId    String
  sectorId    String?
  name        String
  seats       Int         @default(4)
  status      TableStatus @default(FREE)
  sortOrder   Int         @default(0)
  // Token del QR de la mesa: deja pedir sin login. Nullable porque una mesa
  // puede existir sin QR impreso.
  publicToken String?     @unique
  createdAt   DateTime    @default(now())
  createdById String?
  updatedAt   DateTime    @updatedAt
  updatedById String?
  deleted     Boolean     @default(false)
  deletedAt   DateTime?
  deletedById String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sector   Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([businessId])
  @@index([branchId])
  @@index([sectorId])
}

model Order {
  id          String      @id @default(cuid())
  businessId  String
  branchId    String
  tableId     String?
  // Quién la abrió. null = la abrió el cliente desde el QR.
  staffId     String?
  number      Int
  status      OrderStatus @default(OPEN)
  // Concurrencia optimista: sube en cada cambio. Dos dispositivos sobre la
  // misma mesa es lo normal en un salón, no un caso raro.
  version     Int         @default(0)
  subtotal    Int         @default(0)
  discount    Int         @default(0)
  // Del mozo, no del negocio: suma al total pero NO al subtotal.
  tip         Int         @default(0)
  total       Int         @default(0)
  // La venta que se generó al cobrar.
  saleId      String?     @unique
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  createdById String?
  updatedAt   DateTime    @updatedAt
  updatedById String?
  deleted     Boolean     @default(false)
  deletedAt   DateTime?
  deletedById String?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table    Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  staff    User?       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  sale     Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([businessId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  productId   String?
  // Copia del nombre, igual que SaleItem.description: si el producto cambia o
  // se borra, la comanda vieja tiene que seguir diciendo qué se pidió.
  description String
  // Precio base, sin modificadores. En pesos enteros.
  unitPrice   Int
  // En milésimas, como todo el resto (ver src/lib/quantity.ts).
  quantity    Int       @default(1000)
  // (base + Σ modificadores) × cantidad.
  total       Int
  // Instrucción libre para la cocina: "sin azúcar", "bien caliente".
  note        String?
  kdsStatus   KdsStatus @default(PENDING)
  // Para el reloj de la pantalla de cocina.
  sentToKitchenAt DateTime  @default(now())
  readyAt         DateTime?
  createdAt   DateTime  @default(now())

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([kdsStatus])
}

// Igual que SaleItemModifier: guarda copia del nombre y del ajuste para que
// editar un modificador no reescriba comandas viejas.
model OrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  modifierId  String?
  name        String
  priceDelta  Int     @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Recetas y producción (módulo RECIPES)
//
// Qué insumo consume cada producto, cuánto se produjo y qué se tiró. Los
// insumos son Product con kind INGREDIENT, así que el stock, las compras y los
// proveedores ya funcionan para ellos sin escribir nada.
// ─────────────────────────────────────────────────────────────────────────────

model RecipeItem {
  id           String @id @default(cuid())
  // El producto que se elabora.
  productId    String
  // El insumo que consume (un Product con kind INGREDIENT).
  ingredientId String
  // Cuánto lleva UNA unidad del producto, en milésimas de la unidad del
  // insumo: 120 = 0,12 kg de harina.
  quantity     Int

  product    Product @relation("RecetaDelProducto", fields: [productId], references: [id], onDelete: Cascade)
  ingredient Product @relation("InsumoEnRecetas", fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model Production {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String
  productId   String
  // Unidades producidas, en milésimas.
  quantity    Int
  staffId     String?
  createdAt   DateTime @default(now())
  createdById String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  staff    User?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([branchId])
}

// Lo que se tiró y por qué. Sirve para producto terminado y para insumo: las
// dos cosas son un Product, así que alcanza con una relación.
model Waste {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String
  productId   String
  quantity    Int
  reason      String
  staffId     String?
  createdAt   DateTime @default(now())
  createdById String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  staff    User?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([branchId])
}

model Sale {
  id          String     @id @default(cuid())
  branchId    String
  // Quién vendió. En barbería es el barbero (define su comisión y su cierre);
  // en un kiosco es simplemente quién atendió.
  staffId     String
  terminalId  String?
  customerId  String?
  // subtotal = suma de los ítems a precio de lista; total = subtotal - discountTotal.
  subtotal      Int      @default(0)
  discountTotal Int      @default(0)
  // Propina del salón. Va aparte del subtotal a propósito: es plata del mozo,
  // no del negocio, y sumarla a lo facturado infla la contabilidad con algo
  // ajeno. Pero tiene que estar en la venta igual, porque el arqueo de caja
  // cuenta lo que entró al cajón, propina incluida.
  tip           Int      @default(0)
  total         Int
  notes       String?
  channel     SaleChannel @default(COUNTER)
  // Copia de quién atendió y de qué mesa salió. Snapshot y no relación: el
  // comprobante de hace seis meses tiene que seguir diciendo "Mesa 4, atendió
  // Vero" aunque la mesa se haya borrado o Vero ya no trabaje acá.
  waiterName  String?
  tableName   String?
  status      SaleStatus @default(COMPLETED)
  soldAt      DateTime   @default(now())
  createdAt   DateTime   @default(now())
  createdById String?
  updatedAt   DateTime   @updatedAt
  updatedById String?
  deleted     Boolean    @default(false)
  deletedAt   DateTime?
  deletedById String?

  // Datos fiscales del cliente (opcionales): sin CUIT, se factura a Consumidor
  // Final. Con CUIT + condición IVA, permite emitir factura A a una empresa.
  // Se copian a la venta (no se leen del Customer) para que el comprobante
  // quede congelado aunque después cambien los datos del cliente.
  customerName         String?
  customerTaxId        String?
  customerTaxCondition TaxCondition @default(CONSUMIDOR_FINAL)

  // Estado de facturación AFIP/ARCA de esta venta. La emisión real ocurre
  // fuera del cobro (ver módulo de invoicing): un fallo nunca bloquea la venta.
  invoiceType       InvoiceType?
  afipStatus        AfipStatus   @default(NOT_CONFIGURED)
  cae               String?
  caeVencimiento    DateTime?
  afipVoucherNumber Int?
  afipError         String?

  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff          User                   @relation("StaffSales", fields: [staffId], references: [id], onDelete: Restrict)
  terminal       Terminal?              @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       SalePayment[]
  discounts      SaleDiscount[]
  stockMovements StockMovement[]
  accountEntries CustomerAccountEntry[]
  returns        SaleReturn[]
  appointments   Appointment[]
  quote          Quote?
  loyaltyEntries LoyaltyEntry[]

  @@index([branchId, soldAt])
  @@index([staffId, soldAt])
  @@index([terminalId])
  @@index([customerId])
  @@index([deletedAt])
  order Order?
}

model SaleItem {
  id          String    @id @default(cuid())
  saleId      String
  productId   String?
  description String
  // Cantidad en milésimas: 1 unidad = 1000, 1,250 kg = 1250.
  quantity    Int       @default(1000)
  unit        Unit      @default(UNIT)
  unitPrice   Int
  // Descuento por promoción prorrateado a este renglón (ver SaleDiscount).
  discount    Int       @default(0)
  total       Int
  // Costo unitario al momento de vender, congelado para calcular margen histórico.
  unitCost    Int?
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  sale    Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  returns SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([deletedAt])
  modifiers SaleItemModifier[]
}

model SalePayment {
  id          String        @id @default(cuid())
  saleId      String
  method      PaymentMethod
  amount      Int
  createdAt   DateTime      @default(now())
  createdById String?
  updatedAt   DateTime      @updatedAt
  deleted     Boolean       @default(false)
  deletedAt   DateTime?
  deletedById String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method])
  @@index([deleted])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

// Devolución PARCIAL de una venta: el cliente trae dos de las cinco remeras.
// Anular la venta entera sería mentir sobre lo que pasó, así que la devolución
// es un hecho aparte que apunta a la venta original.
model SaleReturn {
  id       String @id @default(cuid())
  saleId   String
  branchId String
  // Plata efectivamente devuelta.
  total    Int
  // Cómo se le devolvió: por una cuenta (sale plata de la caja) o ACCOUNT, que
  // en vez de devolver efectivo le baja la deuda al cliente.
  method   PaymentMethod
  reason      String?
  returnedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  createdById String?

  sale   Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items  SaleReturnItem[]

  @@index([saleId])
  @@index([branchId, returnedAt])
  @@index([method])
}

model SaleReturnItem {
  id         String @id @default(cuid())
  returnId   String
  saleItemId String
  // Cantidad devuelta, en milésimas (se puede devolver medio kilo).
  quantity   Int
  // Plata devuelta por este renglón, ya proporcional al descuento que tuvo.
  amount     Int

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([saleItemId])
}

// Forma de cobro/pago. ACCOUNT (cuenta corriente / "fiado") no es plata que
// entra: no suma al arqueo de caja, genera un cargo en la cuenta del cliente.
enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  QR
  MERCADO_PAGO
  ACCOUNT
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// Promociones
// ─────────────────────────────────────────────────────────────────────────────

model Promotion {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  type        PromotionType
  scope       PromotionScope @default(ALL)

  // Parámetros según `type` (solo se usa el del tipo correspondiente).
  percentOff  Int? // PERCENT_OFF: 1-100
  fixedOff    Int? // FIXED_OFF: pesos a descontar
  buyQuantity Int? // NX_M: llevás N...
  payQuantity Int? // NX_M: ...pagás M
  bundlePrice Int? // BUNDLE_PRICE: precio cerrado del combo

  // Condiciones de disparo.
  minQuantity Int? // en milésimas
  minAmount   Int?

  // Vigencia. `weekdays` es una lista ISO ("1,2,3" = lun/mar/mié); null = todos los días.
  startsAt DateTime?
  endsAt   DateTime?
  weekdays String?

  // Ante empate, se aplica primero la de mayor prioridad.
  priority    Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targets   PromotionTarget[]
  branches  PromotionBranch[]
  discounts SaleDiscount[]

  @@index([businessId])
  @@index([deletedAt])
}

enum PromotionType {
  PERCENT_OFF // % de descuento
  FIXED_OFF // monto fijo de descuento
  NX_M // 3x2, 2x1
  BUNDLE_PRICE // precio cerrado por llevar el combo
}

enum PromotionScope {
  ALL // toda la venta
  CATEGORY // los ítems de ciertas categorías
  PRODUCT // ciertos productos
}

// A qué apunta la promo (según `scope`). Sin filas con scope != ALL, la promo
// no aplica a nada.
model PromotionTarget {
  id          String  @id @default(cuid())
  promotionId String
  productId   String?
  categoryId  String?

  promotion Promotion        @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId])
  @@index([categoryId])
}

// Sucursales donde corre la promo. Sin filas = corre en todas.
model PromotionBranch {
  id          String @id @default(cuid())
  promotionId String
  branchId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([promotionId, branchId])
  @@index([branchId])
}

// Descuento efectivamente aplicado a una venta. Congela el nombre y el monto:
// borrar la promo no cambia lo que ya se cobró.
model SaleDiscount {
  id          String   @id @default(cuid())
  saleId      String
  promotionId String?
  description String
  amount      Int
  createdAt   DateTime @default(now())

  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([promotionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Stock
// ─────────────────────────────────────────────────────────────────────────────

// Existencia actual de un producto en una sucursal. Es un caché derivable de
// StockMovement: se actualiza en la misma transacción que el movimiento.
model StockLevel {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  // En milésimas. Puede ser negativo si se permite vender sin stock.
  quantity  Int      @default(0)
  // Costo promedio ponderado (PPP) de lo que hay acá, en pesos por unidad de
  // medida. Se recalcula en cada entrada: (valor que había + valor que entra) /
  // (cantidad que había + cantidad que entra).
  //
  // No es lo mismo que `Product.cost`, que es el costo de REPOSICIÓN (lo último
  // que se pagó, sirve para fijar precio). Este es a cuánto está valuado lo que
  // hay en la góndola. Con inflación los dos se separan rápido: valuar 100
  // unidades viejas al precio de las 10 que compraste ayer infla el patrimonio
  // y el costo de lo vendido.
  //
  // Es por sucursal porque el stock es por sucursal: dos locales que le compran
  // al mismo proveedor a distinto precio no tienen por qué valuar igual.
  avgCost   Int?
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([productId])
}

// Libro de movimientos de stock: append-only, nunca se edita ni se borra.
// El signo de `quantity` indica entrada (+) o salida (-).
model StockMovement {
  id          String            @id @default(cuid())
  branchId    String
  productId   String
  type        StockMovementType
  quantity    Int
  unitCost    Int?
  reason      String?
  saleId      String?
  purchaseId  String?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  createdById String?

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([branchId, occurredAt])
  @@index([productId, occurredAt])
  @@index([saleId])
  @@index([purchaseId])
}

enum StockMovementType {
  INITIAL // carga inicial de inventario
  PURCHASE // ingreso por compra a proveedor
  PURCHASE_CANCELLED // salida por compra anulada o borrada
  SALE // salida por venta
  SALE_CANCELLED // reposición por venta anulada
  ADJUSTMENT // ajuste manual tras un conteo
  TRANSFER_IN // entrada por transferencia entre sucursales
  TRANSFER_OUT // salida por transferencia entre sucursales
  LOSS // merma, rotura o vencimiento
  RETURN // devolución del cliente
}

// ─────────────────────────────────────────────────────────────────────────────
// Proveedores y cuentas a pagar
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  taxId       String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  expenses  Expense[]

  @@index([businessId])
  @@index([deletedAt])
}

// Factura de compra a un proveedor. Es a la vez el ingreso de mercadería (sus
// ítems mueven stock) y la deuda a pagar (`status` + `dueAt`).
model Purchase {
  id          String         @id @default(cuid())
  businessId  String
  branchId    String?
  supplierId  String
  // Número de comprobante del proveedor (ej: "0001-00012345").
  number      String?
  // Suma de los renglones. Es la deuda que se registra.
  total       Int
  // Lo que dice el papel. Una factura argentina trae percepciones, flete y
  // redondeos que no están en los renglones: si no cierra contra `total`, se
  // avisa en vez de dejar una deuda silenciosamente mal cargada.
  declaredTotal Int?
  // IVA discriminado. Para un Responsable Inscripto es crédito fiscal, o sea
  // que NO es costo: se recupera. Para un monotributista es null y el costo de
  // los renglones ya lo incluye.
  taxAmount   Int?
  // Qué se compró. null = mercadería: entra al stock y se vuelve costo recién
  // cuando se vende. Cualquier otra categoría es un gasto operativo (el service
  // del freezer, el flete, el contador) y baja la ganancia del período en que
  // se emitió la factura.
  expenseCategory ExpenseCategory?
  status      PurchaseStatus @default(PENDING)
  issuedAt    DateTime       @default(now())
  // Vencimiento del pago. Vencida = dueAt en el pasado y status != PAID.
  dueAt       DateTime?
  // Si es true, los ítems ya impactaron en el stock (no se vuelve a aplicar).
  stockApplied Boolean       @default(false)
  notes       String?
  createdAt   DateTime       @default(now())
  createdById String?
  updatedAt   DateTime       @updatedAt
  updatedById String?
  deleted     Boolean        @default(false)
  deletedAt   DateTime?
  deletedById String?

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier       Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  payments       PurchasePayment[]
  credits        PurchaseCredit[]
  stockMovements StockMovement[]

  @@index([businessId, issuedAt])
  @@index([supplierId])
  @@index([status, dueAt])
  @@index([deletedAt])
}

enum PurchaseStatus {
  PENDING // sin pagar
  PARTIAL // pagada en parte
  PAID // saldada
  CANCELLED // anulada
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String?
  description String
  quantity    Int // milésimas
  unit        Unit     @default(UNIT)
  unitCost    Int
  total       Int
  createdAt   DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

// Nota de crédito del proveedor: te bonifica, te devolvés mercadería fallada o
// te facturó de más. Baja lo que le debés SIN mover plata, así que no toca la
// caja — a diferencia de un pago. Sin esto, el único arreglo era pagar de menos
// y dejar la factura en "pago parcial" para siempre.
model PurchaseCredit {
  id          String   @id @default(cuid())
  purchaseId  String
  amount      Int
  // Número de la nota de crédito del proveedor.
  number      String?
  reason      String?
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  createdById String?
  deleted     Boolean  @default(false)
  deletedAt   DateTime?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([issuedAt])
  @@index([deletedAt])
}

// Pago (total o parcial) de una factura de compra. Sale de una cuenta, así que
// impacta en el arqueo de caja igual que un gasto.
model PurchasePayment {
  id          String        @id @default(cuid())
  purchaseId  String
  method      PaymentMethod @default(CASH)
  amount      Int
  paidAt      DateTime      @default(now())
  note        String?
  createdAt   DateTime      @default(now())
  createdById String?
  deleted     Boolean       @default(false)
  deletedAt   DateTime?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([paidAt])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Clientes y cuenta corriente
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  taxId        String?
  taxCondition TaxCondition?
  phone        String?
  email        String?
  address      String?
  notes        String?
  // Tope de deuda permitido (pesos). null = sin límite.
  creditLimit  Int?
  // Cumpleaños. Se guarda la fecha completa pero solo se usan día y mes: el año
  // casi nunca lo dan y no hace falta para saludar.
  birthday     DateTime?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  createdById  String?
  updatedAt    DateTime      @updatedAt
  updatedById  String?
  deleted      Boolean       @default(false)
  deletedAt    DateTime?
  deletedById  String?

  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales          Sale[]
  accountEntries CustomerAccountEntry[]
  appointments   Appointment[]
  quotes         Quote[]
  loyaltyEntries LoyaltyEntry[]

  @@index([businessId])
  @@index([deletedAt])
}

// Libro de cuenta corriente del cliente: append-only. El saldo es la suma
// algebraica de los `amount` (cargo positivo, pago negativo).
model CustomerAccountEntry {
  id          String                   @id @default(cuid())
  customerId  String
  // Sucursal donde se cobró. Necesaria para que el pago de un fiado entre en el
  // arqueo de la caja correcta (el cliente paga en un mostrador concreto).
  branchId    String?
  type        CustomerAccountEntryType
  // Positivo = aumenta la deuda (venta fiada). Negativo = la baja (pago).
  amount      Int
  saleId      String?
  method      PaymentMethod?
  note        String?
  occurredAt  DateTime                 @default(now())
  createdAt   DateTime                 @default(now())
  createdById String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([saleId])
}

enum CustomerAccountEntryType {
  CHARGE // venta a cuenta (fiado)
  PAYMENT // pago a cuenta
  ADJUSTMENT // corrección manual
}

// ─────────────────────────────────────────────────────────────────────────────
// Gastos y caja
// ─────────────────────────────────────────────────────────────────────────────

// Plata que salió y ya está paga. Lo que se le compra a un proveedor a pagar
// después no es un gasto sino una `Purchase`: es deuda, y recién impacta en la
// caja cuando se paga (igual que el fiado del lado de las ventas). Un gasto
// puede igual nombrar al proveedor —"le pagué $30.000 al verdulero"— sin
// arrastrar factura, vencimiento ni mercadería.
model Expense {
  id            String          @id @default(cuid())
  businessId    String
  branchId      String?
  supplierId    String?
  category      ExpenseCategory
  // Cuenta de la que salió la plata (para conciliar con los ingresos por método en el cierre de caja).
  paymentMethod PaymentMethod   @default(CASH)
  amount        Int
  note          String?
  spentAt       DateTime        @default(now())
  createdAt     DateTime        @default(now())
  createdById   String?
  updatedAt     DateTime        @updatedAt
  updatedById   String?
  deleted       Boolean         @default(false)
  deletedAt     DateTime?
  deletedById   String?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([businessId, spentAt])
  @@index([branchId])
  @@index([supplierId])
  @@index([deletedAt])
}

enum ExpenseCategory {
  RENT
  SALARIES
  SUPPLIES
  UTILITIES
  MARKETING
  MAINTENANCE
  TAXES
  MERCHANDISE
  OTHER
}

// Saldo inicial (apertura) de una cuenta. Opcionalmente por sucursal.
model AccountOpeningBalance {
  id            String        @id @default(cuid())
  businessId    String
  branchId      String?
  paymentMethod PaymentMethod
  amount        Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([branchId])
}

// Movimiento de plata entre dos cuentas (ej: de Mercado Pago a Efectivo).
model AccountTransfer {
  id          String        @id @default(cuid())
  businessId  String
  branchId    String?
  fromMethod  PaymentMethod
  toMethod    PaymentMethod
  amount      Int
  note        String?
  movedAt     DateTime      @default(now())
  createdAt   DateTime      @default(now())
  createdById String?
  deleted     Boolean       @default(false)
  deletedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([businessId, movedAt])
  @@index([branchId])
  @@index([deletedAt])
}

// Cierre de caja: foto de los saldos por cuenta en un momento (arqueo).
model CashClose {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String?
  closedAt    DateTime @default(now())
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines    CashCloseLine[]

  @@index([businessId, closedAt])
  @@index([branchId])
}

// Detalle por cuenta de un cierre: saldo teórico (sistema) vs contado.
model CashCloseLine {
  id            String        @id @default(cuid())
  closeId       String
  paymentMethod PaymentMethod
  systemAmount  Int
  countedAmount Int

  close CashClose @relation(fields: [closeId], references: [id], onDelete: Cascade)

  @@index([closeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Facturación y auditoría
// ─────────────────────────────────────────────────────────────────────────────

// Condición frente al IVA (AFIP/ARCA). Se usa tanto para el negocio emisor
// como para el cliente de una venta.
enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_RESPONSABLE
}

// Tipo de comprobante AFIP/ARCA (CbteTipo: A=1, B=6, C=11).
enum InvoiceType {
  A
  B
  C
}

// Estado de facturación AFIP/ARCA de una venta.
enum AfipStatus {
  NOT_CONFIGURED
  PENDING
  ISSUED
  FAILED
}

enum LogLevel {
  ERROR
  WARN
  INFO
}

// ─────────────────────────────────────────────────────────────────────────────
// Turnos
// ─────────────────────────────────────────────────────────────────────────────

// Un turno agendado. Existe antes de que haya venta: cuando el cliente viene y
// se le cobra, el turno queda enlazado a la venta (`saleId`) y así se puede ver
// qué se agendó, qué se atendió y qué se facturó.
//
// El cliente puede ser de la ficha (`customerId`) o suelto (`customerName` +
// teléfono): al que llama por primera vez no se le pide que sea "cliente" antes
// de poder anotarlo.
model Appointment {
  id            String            @id @default(cuid())
  businessId    String
  branchId      String
  staffId       String?
  customerId    String?
  customerName  String?
  customerPhone String?
  // Servicio a realizar. Sirve para saber cuánto dura y cuánto se va a cobrar.
  productId     String?
  startsAt      DateTime
  // Duración en minutos: define el bloque que ocupa en la agenda.
  durationMinutes Int             @default(30)
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  saleId        String?
  createdAt     DateTime          @default(now())
  createdById   String?
  updatedAt     DateTime          @updatedAt
  deleted       Boolean           @default(false)
  deletedAt     DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff    User?     @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([businessId, startsAt])
  @@index([branchId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@index([deletedAt])
}

enum AppointmentStatus {
  SCHEDULED // Anotado
  CONFIRMED // El cliente confirmó que viene
  DONE // Atendido
  CANCELLED // Se canceló con aviso
  NO_SHOW // No vino
}

// Registro de backend: errores y eventos clave (auditoría). Sin relaciones (append-only,
// puede referenciar entidades ya borradas). Se purga solo pasados los 90 días.
model AppLog {
  id         String   @id @default(cuid())
  level      LogLevel
  event      String
  message    String
  context    String?
  businessId String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([level, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Puntos
// ─────────────────────────────────────────────────────────────────────────────

// Libro de puntos del cliente: append-only, igual que la cuenta corriente. El
// saldo es la suma de los `points` (positivo suma, negativo canjea). No se
// guarda un total porque un total se desincroniza; la suma nunca miente.
model LoyaltyEntry {
  id         String @id @default(cuid())
  businessId String
  customerId String
  // Positivo = acumulado por una compra. Negativo = canjeado.
  points     Int
  // Venta que los generó, si vinieron de una compra.
  saleId     String?
  note       String?

  createdAt   DateTime @default(now())
  createdById String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@index([saleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Presupuestos
// ─────────────────────────────────────────────────────────────────────────────

// Un presupuesto es una venta que todavía no pasó. El corralón que cotiza 40
// metros de caño y el de la mercería que arma una lista para un colegio hoy lo
// hacen en un papel, y cuando el cliente vuelve a los diez días nadie se acuerda
// del precio que le dijeron. Acá queda escrito, con fecha de vencimiento: los
// precios se mueven, y un presupuesto sin vencimiento es una trampa para el que
// lo firmó.
enum QuoteStatus {
  OPEN // Entregado, esperando respuesta
  ACCEPTED // El cliente dijo que sí (todavía no se cobró)
  REJECTED // No va
  CONVERTED // Ya se convirtió en venta
}

model Quote {
  id         String      @id @default(cuid())
  businessId String
  branchId   String
  // Numeración por negocio, para poder decir "el presupuesto 42" por teléfono.
  number     Int
  status     QuoteStatus @default(OPEN)

  customerId    String?
  // Copiados al presupuesto: quien pide una cotización muchas veces todavía no
  // es un cliente de la ficha.
  customerName  String?
  customerPhone String?

  subtotal      Int     @default(0)
  discountTotal Int     @default(0)
  total         Int     @default(0)
  notes         String?

  // Hasta cuándo vale. Vencido no se bloquea nada: se avisa fuerte y se puede
  // rehacer con los precios de hoy.
  validUntil DateTime

  // Token del link público. El cliente lo abre sin cuenta, desde el WhatsApp.
  publicToken String @unique

  // La venta que salió de acá, si se convirtió.
  saleId String? @unique

  createdAt   DateTime  @default(now())
  createdById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    QuoteItem[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([branchId])
  @@index([customerId])
  @@index([deletedAt])
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  // Opcional a propósito: "mano de obra" y "flete" no están en el catálogo y son
  // la mitad de lo que se cotiza en una ferretería.
  productId String?
  description String
  // Cantidad en milésimas, igual que en la venta.
  quantity  Int   @default(1000)
  unit      Unit  @default(UNIT)
  unitPrice Int
  total     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  deletedAt DateTime?

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
}
