# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# gentle-ai skill-registry: cache regenerado por máquina, con paths
# absolutos del usuario local. No es reproducible entre devs, así que
# no se versiona. Se regenera con `gentle-ai skill-registry refresh`.
.atl/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/supabase/.branches
/supabase/.temp

# Capturas de pantalla generadas (no son código fuente)
/capturas

# Planchas de imágenes generadas por IA: son material de origen, no producto.
# Pesan ~2 MB cada una y las 14 del catálogo de verdulería serían 30 MB al pedo.
# Lo que se commitea es el resultado: los .webp de 512 en public/catalog/.
/sheets
/.sheet-preview

# Playwright
/test-results/
/playwright-report/
/blob-report/
# Cookies de sesión de los e2e: son credenciales vivas, no artefactos.
/e2e/.auth/

# Indice local de CodeGraph: es por checkout y no se comparte.
.codegraph/
