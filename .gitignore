# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# e2e
/test-results
/playwright-report
/e2e/.auth
/e2e/seed-ids.json
/supabase/.branches
/supabase/.temp

# Capturas de pantalla generadas (no son código fuente)
/capturas

# Planchas de imágenes generadas por IA: son material de origen, no producto.
# Pesan ~2 MB cada una y las 14 del catálogo de verdulería serían 30 MB al pedo.
# Lo que se commitea es el resultado: los .webp de 512 en public/catalog/.
/sheets
/.sheet-preview
