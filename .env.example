# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env` para desarrollo. Producción usa `/etc/bills.env`
# generado desde el repositorio `nebula-ar/supabase-infra`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos ---------------------------------------------------------
# Supabase CLI local (`npx supabase start`) usa PostgreSQL directo. En la VPS,
# DATABASE_URL apunta a Supavisor transaction :6543 y DIRECT_URL a PG :54322.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase Auth / sesiones ---------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_INTERNAL_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="copiar-desde-supabase-status"
SUPABASE_SERVICE_ROLE_KEY="copiar-desde-supabase-status"
EXPECTED_ENVIRONMENT_INSTANCE_ID="00000000-0000-4000-8000-000000000001"

# Independientes entre sí; mínimo 32 caracteres.
STAFF_SESSION_SECRET="cambiame-staff-session-32-caracteres"
AUTH_RATE_LIMIT_SECRET="cambiame-auth-rate-limit-32-caracteres"
# Máximo de altas por IP y por hora. Si se omite, producción usa 6.
AUTH_REGISTER_IP_MAX_ATTEMPTS="6"

# --- Opcional --------------------------------------------------------------
# Orígenes permitidos para el dev server de Next accedido por IP de LAN.
# Por defecto se deriva del host de APP_URL; solo seteá esto para overridear.
# ALLOWED_DEV_ORIGINS="192.168.18.11"

# --- Facturación electrónica AFIP/ARCA (AfipSDK) ---------------------------
# Opcional mientras no factures de verdad: sin este token, la emisión falla
# con un mensaje claro (no rompe nada). Creá una cuenta gratis en
# https://app.afipsdk.com y pegá tu token acá.
AFIPSDK_ACCESS_TOKEN=""
# "true" para pegarle a AFIP/ARCA de producción. Default false (sandbox/dev) —
# dejalo así hasta que un Business tenga certificado real.
AFIPSDK_PRODUCTION="false"

# Clave simétrica para cifrar en reposo el certificado/clave privada AFIP de
# cada Business. Generar con: openssl rand -base64 32
CERT_ENCRYPTION_KEY=""

# --- Imágenes de producto con IA (OpenRouter) ------------------------------
# Opcional: si está vacío, la carga de fotos sigue funcionando y las acciones
# de IA no se muestran. La key se usa solo en el servidor y nunca llega al navegador.
# Cada negocio puede pedir 5 generaciones por día. Cada llamada devuelve una
# imagen; al regenerar, la interfaz conserva las versiones de esa sesión.
OPENROUTER_API_KEY=""

# --- Syncfusion EJ2 (dashboard) --------------------------------------------
# License key de Syncfusion para los componentes EJ2. Se registra en el bundle
# del cliente (así lo exige Syncfusion, la key no es un secreto). Si se omite,
# se usa la key por defecto de Bills; seteala acá para overridear en algún
# entorno puntual.
NEXT_PUBLIC_SYNCFUSION_LICENSE_KEY=""
