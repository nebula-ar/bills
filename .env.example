# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env` (dev local) y configurá las variables en Vercel
# (Project Settings → Environment Variables) para producción.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos ---------------------------------------------------------
# DESARROLLO LOCAL (SQLite): dejá esto tal cual.
DATABASE_URL="file:./dev.db"

# PRODUCCIÓN (Supabase / Postgres): reemplazá DATABASE_URL por la connection
# string "pooled" (Transaction, puerto 6543) y agregá DIRECT_URL (Direct,
# puerto 5432) que se usa solo para migraciones.
#
#   DATABASE_URL="postgres://postgres.<REF>:<PASSWORD>@<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgres://postgres.<REF>:<PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"
#
# DIRECT_URL solo hace falta en el entorno donde corren las migraciones (Vercel
# build). En local con SQLite no se usa.
# DIRECT_URL=""

# --- NextAuth --------------------------------------------------------------
# Secreto para firmar sesiones. Generá uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiame-por-un-secreto-fuerte"

# URL pública de la app.
#   - Local:      http://localhost:3000  (o http://<IP-LAN>:3000 para probar del celu)
#   - Producción: https://<tu-app>.vercel.app  (o tu dominio propio)
NEXTAUTH_URL="http://localhost:3000"

# --- Opcional --------------------------------------------------------------
# Orígenes permitidos para el dev server de Next accedido por IP de LAN.
# Por defecto se deriva del host de NEXTAUTH_URL; solo seteá esto para overridear.
# ALLOWED_DEV_ORIGINS="192.168.18.11"

# --- Facturación electrónica AFIP/ARCA (AfipSDK) ---------------------------
# Opcional mientras no factures de verdad: sin este token, la emisión falla
# con un mensaje claro (no rompe nada). Creá una cuenta gratis en
# https://app.afipsdk.com y pegá tu token acá.
AFIPSDK_ACCESS_TOKEN=""
# "true" para pegarle a AFIP/ARCA de producción. Default false (sandbox/dev) —
# dejalo así hasta que un Business tenga certificado real.
AFIPSDK_PRODUCTION="false"

# Clave simétrica para cifrar en reposo el certificado/clave privada AFIP de
# cada Business. Generar con: openssl rand -base64 32
CERT_ENCRYPTION_KEY=""
